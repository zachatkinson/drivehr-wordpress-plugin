{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "drivehr/job-list",
	"version": "1.0.0",
	"title": "DriveHR Job List",
	"category": "widgets",
	"icon": "list-view",
	"description": "Display all available job postings in a modern, accessible list format.",
	"keywords": ["jobs", "careers", "employment", "hiring", "drivehr", "list"],
	"textdomain": "drivehr-webhook",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontWeight": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true
	},
	"attributes": {
		"showLocation": {
			"type": "boolean",
			"default": true
		},
		"showJobType": {
			"type": "boolean",
			"default": true
		},
		"postsPerPage": {
			"type": "number",
			"default": 50
		},
		"orderBy": {
			"type": "string",
			"default": "date",
			"enum": ["date", "title", "modified"]
		},
		"order": {
			"type": "string",
			"default": "DESC",
			"enum": ["ASC", "DESC"]
		},
		"cardBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"cardTextColor": {
			"type": "string",
			"default": ""
		},
		"cardTitleColor": {
			"type": "string",
			"default": ""
		},
		"cardBorder": {
			"type": "object",
			"default": {
				"color": "",
				"style": "solid",
				"width": "0px"
			}
		},
		"cardBorderRadius": {
			"type": "string",
			"default": "8px"
		},
		"cardShadow": {
			"type": "string",
			"default": ""
		},
		"cardPadding": {
			"type": "object",
			"default": {
				"top": "md",
				"right": "md",
				"bottom": "md",
				"left": "md"
			}
		}
	},
	"example": {
		"attributes": {
			"showLocation": true,
			"showJobType": true,
			"postsPerPage": 3
		}
	},
	"editorScript": "file:./build/index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css"
}
